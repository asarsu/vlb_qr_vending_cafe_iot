# Entorno y Configuración Kiosco QR Vending
DEV_MODE=0
SCREEN_W=480
SCREEN_H=800

# API BISA / SIP
BISA_BASE_URL=https://dev-sip.mc4.com.bo:8443
BISA_API_KEY_AUTH=tu_apikey_auth_aqui
BISA_USERNAME=tu_usuario_bisa_aqui
BISA_PASSWORD=tu_password_bisa_aqui
BISA_APIKEY_SERVICIO=tu_apikey_servicio_aqui
WEBHOOK_CALLBACK_URL=https://qr01.vendingbolivia.com/api/pagos/callback
WEBHOOK_PORT=5000
WEBHOOK_SECRET_TOKEN=tu_token_secreto_webhook_aqui

# MDB / Hardware Serial
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=0.1

# Operación
MONTO_INICIAL_BS=5.00
TIMEOUT_PAGO_SEGUNDOS=180
TIMEOUT_VMC_SEGUNDOS=120
