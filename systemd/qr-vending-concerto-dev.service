[Unit]
Description=Kiosco QR Vending - Servicio de Arranque y Supervisión (Necta Concerto - Entorno Local Dev)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=andres
Group=andres

WorkingDirectory=/home/andres/Documentos/Proyecto-QR-2025/python_localQR_concerto_v1.0

Environment="PYTHONUNBUFFERED=1"
Environment="DISPLAY=:0"
EnvironmentFile=-/home/andres/Documentos/Proyecto-QR-2025/python_localQR_concerto_v1.0/.env

ExecStart=/home/andres/Documentos/Proyecto-QR-2025/python_localQR_concerto_v1.0/scripts/check_and_run.sh

Restart=always
RestartSec=5s

StartLimitIntervalSec=120s
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=qr-vending-concerto

KillMode=mixed
TimeoutStopSec=10s

[Install]
WantedBy=graphical.target
